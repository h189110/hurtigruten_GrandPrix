{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ais": {
    "BaseUrl": "https://kystdatahuset.kystverket.no/ws/",
    "RealtimeGeoJsonPath": "api/ais/realtime/geojson",
    "UserAgent": "HurtigrutenGrandPrix/1.0 (+https://github.com/hurtigrute-grand-prix)",
    "HttpTimeoutSeconds": 20,
    "PollingIntervalSeconds": 30,
    "FreshMaxAgeSeconds": 60,
    "DelayedMaxAgeSeconds": 180,
    "StaleMaxAgeSeconds": 600
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
